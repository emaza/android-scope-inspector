<?xml version="1.0" encoding="utf-8"?>
<!-- La app no guarda nada que deba salir del dispositivo: se excluye todo de la copia en la nube
     y de la transferencia entre dispositivos (coherente con android:allowBackup="false"). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
